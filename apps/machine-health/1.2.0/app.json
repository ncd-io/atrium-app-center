  "minPlatformVersion": "2.3.1",
  "models": ["EG5120"],
  "license": {
    "required": true
  },
  "entries": {
    "api": "backend/api/index.js",
    "ingest": "backend/ingest/index.js",
    "frontend": "frontend"
  },
  "hooks": {
    "postInstall": "backend/hooks/post-install.js"
  },
  "capabilities": [
    "data:read",
    "telemetry:subscribe",
    "radio:fft",
    "notify:email",
